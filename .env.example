# Copy this example to .env and edit the settings you need.
# Remove optional overrides to use the defaults in mise.toml.
# Keep real secrets in .env.

# Python project paths
PROJECT_ROOT="."

# Python source
PYTHON_SOURCE="src"

# Python tests
PYTHON_TESTS="tests"

# Nuitka build
PYTHON_ENTRYPOINT="src/kitflow/__main__.py"
PYTHON_BUILD_DIRECTORY="dist"
